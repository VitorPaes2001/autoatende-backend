const { createClient } = require('@supabase/supabase-js');

const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;

function isValidUrl(u) {
  try {
    new URL(u);
    return true;
  } catch {
    return false;
  }
}

function isLikelyKey(k) {
  return typeof k === 'string' && k.trim().length >= 20;
}

function responseList() {
  return { data: [], error: null, status: 200, count: null };
}

function responseSingle() {
  return { data: null, error: null, status: 200, count: null };
}

function makeThenable(resp) {
  return {
    ...resp,
    then: (resolve, reject) => Promise.resolve(resp).then(resolve, reject),
    catch: (reject) => Promise.resolve(resp).catch(reject),
    finally: (f) => Promise.resolve(resp).finally(f),
  };
}

function createBuilder() {
  let isSingle = false;

  const builder = {
    single: () => { isSingle = true; return builder; },
    maybeSingle: () => { isSingle = true; return builder; },

    select: () => builder,
    insert: () => builder,
    update: () => builder,
    upsert: () => builder,
    delete: () => builder,

    eq: () => builder,
    neq: () => builder,
    in: () => builder,
    contains: () => builder,
    ilike: () => builder,
    like: () => builder,
    gte: () => builder,
    lte: () => builder,
    gt: () => builder,
    lt: () => builder,
    or: () => builder,
    order: () => builder,
    limit: () => builder,
    range: () => builder,

    then: (resolve, reject) => Promise.resolve(isSingle ? responseSingle() : responseList()).then(resolve, reject),
    catch: (reject) => Promise.resolve(isSingle ? responseSingle() : responseList()).catch(reject),
    finally: (f) => Promise.resolve(isSingle ? responseSingle() : responseList()).finally(f),
  };

  return builder;
}

function createStub() {
  const onceKey = '__AAI_SUPABASE_DEGRADED_LOGGED__';
  if (!global[onceKey]) {
    global[onceKey] = true;
    console.warn('[supabase] degraded mode: SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY missing/invalid; using stub client');
  }

  return {
    from: () => createBuilder(),
    rpc: () => makeThenable(responseSingle()),
    auth: {
      getUser: async () => ({ data: { user: null }, error: null }),
      admin: {
        listUsers: async () => ({ data: { users: [] }, error: null }),
        createUser: async () => ({ data: { user: null }, error: null }),
        updateUserById: async () => ({ data: { user: null }, error: null }),
      },
    },
  };
}

let supabase;
try {
  const envOk = isValidUrl(SUPABASE_URL) && isLikelyKey(SUPABASE_SERVICE_ROLE_KEY);
  supabase = envOk ? createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY) : createStub();
} catch {
  supabase = createStub();
}

module.exports = supabase;
